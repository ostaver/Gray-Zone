---
import Base from '../layouts/Base.astro';
import Preloader from '../components/shell/Preloader.astro';
import Hero from '../components/hero/Hero.astro';
import DownloadModal from '../components/ui/DownloadModal.astro';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<Base locale={locale}>
  <Preloader slot="chrome" locale={locale} />
  <Hero locale={locale} />
  <DownloadModal slot="chrome" locale={locale} />
</Base>
