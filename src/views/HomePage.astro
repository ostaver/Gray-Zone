---
import Base from '../layouts/Base.astro';
import Preloader from '../components/shell/Preloader.astro';
import Nav from '../components/shell/Nav.astro';
import Hero from '../components/hero/Hero.astro';
import About from '../components/about/About.astro';
import Story from '../components/story/Story.astro';
import Gallery from '../components/gallery/Gallery.astro';
import Tutorial from '../components/tutorial/Tutorial.astro';
import Team from '../components/team/Team.astro';
import Play from '../components/play/Play.astro';
import Contact from '../components/contact/Contact.astro';
import Footer from '../components/shell/Footer.astro';
import DownloadModal from '../components/ui/DownloadModal.astro';
import { sections } from '../data/sections';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<Base locale={locale}>
  <Preloader slot="chrome" />
  <Nav slot="chrome" locale={locale} />
  <Hero locale={locale} />
  {
    sections.map((id) =>
      id === 'about' ? (
        <>
          <About locale={locale} />
          <Story locale={locale} />
        </>
      ) : id === 'gallery' ? (
        <Gallery locale={locale} />
      ) : id === 'tutorial' ? (
        <Tutorial locale={locale} />
      ) : id === 'team' ? (
        <>
          <Team locale={locale} />
          <Play locale={locale} />
        </>
      ) : (
        <Contact locale={locale} />
      ),
    )
  }
  <Footer slot="footer" locale={locale} />
  <DownloadModal slot="chrome" locale={locale} />
</Base>
