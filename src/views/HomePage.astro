---
import Base from '../layouts/Base.astro';
import Preloader from '../components/shell/Preloader.astro';
import Nav from '../components/shell/Nav.astro';
import Hero from '../components/hero/Hero.astro';
import SectionPlaceholder from '../components/ui/SectionPlaceholder.astro';
import DownloadModal from '../components/ui/DownloadModal.astro';
import { sectionIndex, sections } from '../data/sections';
import type { Locale } from '../i18n/config';
import { ui } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<Base locale={locale}>
  <Preloader slot="chrome" />
  <Nav slot="chrome" locale={locale} />
  <Hero locale={locale} />
  {sections.map((id, i) => <SectionPlaceholder id={id} index={sectionIndex(i)} title={ui[locale].nav[id]} />)}
  <DownloadModal slot="chrome" locale={locale} />
</Base>
