---
import type { Locale } from '../../i18n/config';
import { ui } from '../../i18n/ui';
import { latestRelease } from '../../data/links';
import CoolButton from '../ui/CoolButton.astro';
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale].hero;
const titleText = t.title.join(' ');
---

<section class="hero" id="top" data-hero aria-labelledby="hero-title">
  <div class="hero__pin" data-hero-pin>
    <div class="hero__gl" data-hero-gl aria-hidden="true"></div>

    <div class="hero__fallback" aria-hidden="true">
      <div class="hero__half hero__half--honest" data-seam-clip="left"></div>
      <div class="hero__half hero__half--gray" data-seam-clip="right"></div>
    </div>
    <div class="hero__shade" aria-hidden="true"></div>

    <h1 class="hero__title" id="hero-title">
      <span class="sr-only">{titleText}</span>
      <span class="hero__layer hero__layer--gray" aria-hidden="true">
        {t.title.map((line) => <span class="line-mask"><span class="hero__line">{line}</span></span>)}
      </span>
      <span class="hero__layer hero__layer--honest" data-seam-clip="left" aria-hidden="true">
        {t.title.map((line) => <span class="line-mask"><span class="hero__line">{line}</span></span>)}
      </span>
    </h1>

    <div class="hero__sides label" aria-hidden="true">
      <span class="hero__side hero__side--honest" data-side="honest">← {t.honest}</span>
      <span class="hero__side hero__side--gray" data-side="gray">{t.gray} →</span>
    </div>

    <div class="hero__bottom">
      <div class="hero__lead" data-hero-fade>
        <p>{t.lead}</p>
        <ul class="hero__facts label">
          {t.facts.map((f) => <li>{f}</li>)}
        </ul>
      </div>
      <div class="hero__scroll" data-hero-fade aria-hidden="true">
        <span class="hero__scroll-line"></span>
      </div>
      <div class="hero__ctas" data-hero-fade>
        <CoolButton href={latestRelease} data-download data-magnetic>
          <span class="btn__label">{t.cta}</span>
          <span class="btn__os" data-os-label></span>
          <span class="btn__icon" aria-hidden="true">↓</span>
        </CoolButton>
      </div>
    </div>
  </div>
</section>

<script>
  import { initHero } from './hero';
  const root = document.querySelector<HTMLElement>('[data-hero]');
  if (root) initHero(root);
</script>

<style>
  .hero {
    position: relative;
    height: 220svh;
  }
  .hero__pin {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: clip;
    display: grid;
    grid-template-rows: 1fr auto;
    padding: calc(var(--nav-h) + 0.75rem) var(--gutter) var(--gutter);
    touch-action: pan-y;
  }
  .hero__gl,
  .hero__fallback,
  .hero__shade {
    position: absolute;
    inset: 0;
  }
  .hero__fallback {
    display: none;
  }
  :global(.no-js) .hero__fallback,
  :global(.no-webgl) .hero__fallback {
    display: block;
  }
  /* Static stand-in for the WebGL field: the same dot grid and palettes, frozen. */
  .hero__half {
    position: absolute;
    inset: 0;
    mask-image: radial-gradient(ellipse 75% 70% at 50% 50%, #000 30%, transparent 100%);
  }
  .hero__half--honest {
    clip-path: inset(0 50% 0 0);
    background: radial-gradient(circle, rgb(227 38 31 / 0.55) 0 26%, transparent 32%) 0 0 / 16px 16px;
  }
  .hero__half--gray {
    clip-path: inset(0 0 0 50%);
    background: radial-gradient(circle, rgb(138 138 134 / 0.45) 0 22%, transparent 28%) 0 0 / 16px 16px;
  }
  .hero__shade {
    background:
      radial-gradient(60% 45% at 50% 50%, rgb(10 10 10 / 0.55), transparent 70%),
      linear-gradient(to bottom, rgb(10 10 10 / 0.88), rgb(10 10 10 / 0.35) 20%, transparent 32%, transparent 60%, rgb(10 10 10 / 0.9));
    pointer-events: none;
  }

  /* ── Title ─────────────────────────────────────────── */
  .hero__title {
    position: relative;
    display: grid;
    place-self: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: min(21vw, 29svh);
    line-height: 0.84;
    letter-spacing: -0.012em;
    /* Shared by both layers: the honest stroke must fully cover the outline beneath it. */
    --title-stroke: max(1.5px, 0.012em);
    text-transform: uppercase;
    text-align: center;
    user-select: none;
  }
  .hero__layer {
    grid-area: 1 / 1;
    display: block;
  }
  /* Solid type over the (unclipped, static) outline layer, clipped to the honest side of the
     seam. Its matching stroke covers the outline beneath. Only this plain layer repaints as
     the seam moves. */
  .hero__layer--honest {
    color: var(--paper);
    -webkit-text-stroke: var(--title-stroke) var(--paper);
    clip-path: inset(0 50% 0 0);
  }
  /* Hollow outline type: the gray zone's letters are empty. */
  .hero__layer--gray {
    color: transparent;
    -webkit-text-stroke: var(--title-stroke) var(--paper);
  }
  .hero__line {
    display: block;
  }
  /* Set once the intro has finished: the scroll scatter flies the letters out of their lines. */
  .hero__title.is-free .line-mask {
    overflow: visible;
  }

  .hero__sides {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    pointer-events: none;
    visibility: hidden;
  }
  .hero[data-live] .hero__sides {
    visibility: visible;
  }
  .hero__side {
    position: absolute;
    left: 0;
    top: 0;
    padding: 0.4rem 0.65rem;
    white-space: nowrap;
    will-change: transform;
  }
  .hero__side--honest {
    background: var(--paper);
    color: var(--ink);
  }
  .hero__side--gray {
    background: rgb(10 10 10 / 0.75);
    color: var(--paper-dim);
    box-shadow: inset 0 0 0 1px var(--hairline);
  }

  /* ── Bottom row ────────────────────────────────────── */
  .hero__bottom {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: end;
    gap: 2rem;
  }
  .hero__lead {
    max-width: 34ch;
  }
  .hero__lead p {
    font-size: clamp(0.95rem, 1.1vw, 1.1rem);
    line-height: 1.5;
    color: var(--paper-dim);
  }
  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.1rem;
    margin-top: 1rem;
    padding: 0;
    list-style: none;
    color: var(--ash);
  }
  .hero__facts li::before {
    content: '■';
    margin-right: 0.45rem;
    color: var(--red);
    font-size: 0.5rem;
    vertical-align: 0.1em;
  }
  .hero__scroll {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    color: var(--ash);
    text-align: center;
  }
  /* A drop of light running down a clipped track: a transform animation, so it stays on the
     compositor. */
  .hero__scroll-line {
    position: relative;
    width: 1px;
    height: 3rem;
    overflow: hidden;
  }
  .hero__scroll-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent, var(--paper));
    animation: drip 2.2s var(--ease-in-out) infinite;
  }
  @keyframes drip {
    from { transform: translateY(-100%); }
    to { transform: translateY(100%); }
  }
  .hero__ctas {
    justify-self: end;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }

  /* ── Buttons ───────────────────────────────────────── */
  .btn__os:empty {
    display: none;
  }
  .btn__os {
    opacity: 0.75;
  }
  .btn__icon {
    display: inline-block;
    transition: transform 0.5s var(--ease-out);
  }
  /* ── Small screens ─────────────────────────────────── */
  @media (max-width: 760px) {
    .hero__pin {
      padding-top: calc(var(--nav-h) + 0.25rem);
    }
    .hero__title {
      font-size: min(33vw, 25svh);
    }
    .hero__bottom {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .hero__scroll {
      display: none;
    }
    .hero__ctas {
      justify-self: stretch;
    }
    .hero__ctas :global(.cool-btn) {
      flex: 1;
      width: 100%;
    }
    .hero__facts {
      display: none;
    }
  }

  /* Landscape phones and other short viewports: the pin is exactly one viewport tall and
     clips its overflow, so the primary action must fit above the fold on its own. */
  @media (max-height: 520px) {
    .hero__pin {
      padding-top: calc(var(--nav-h) + 0.25rem);
      padding-bottom: 1rem;
    }
    .hero__title {
      font-size: min(21vw, 26svh);
    }
    .hero__bottom {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 1rem;
    }
    .hero__scroll,
    .hero__facts {
      display: none;
    }
    .hero__ctas {
      justify-self: end;
    }
    .hero__ctas :global(.cool-btn) {
      flex: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-line::after {
      animation: none;
    }
  }
</style>
