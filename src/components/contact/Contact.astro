---
import type { Locale } from '../../i18n/config';
import { contactCopy, type ContactChannel } from '../../data/contact';
import { repo, socials } from '../../data/links';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = contactCopy[locale];
const [mailbox, domain] = socials.email.split('@');

// Each value is split where it may wrap, so a long address breaks at the @ and not mid-word.
const channels: { id: ContactChannel; href: string; parts: string[]; external: boolean }[] = [
  { id: 'email', href: `mailto:${socials.email}`, parts: [mailbox, `@${domain}`], external: false },
  { id: 'instagram', href: socials.instagram, parts: [`@${socials.instagramHandle}`], external: true },
  { id: 'github', href: repo, parts: [t.source], external: true },
  { id: 'issues', href: `${repo}/issues/new`, parts: [t.bugReport], external: true },
];
---

<section class="ct" id="contact" aria-labelledby="contact-title" data-contact>
  <header class="ct__head">
    <h2 class="ct__title" id="contact-title" data-ct-print>{t.title}</h2>
    <p class="ct__text" data-ct-print>{t.text}</p>
  </header>

  <ul class="ct__channels" role="list">
    {channels.map((c) => (
      <li class="ct__channel" data-ct-channel>
        <span class="ct__rule" aria-hidden="true" data-ct-rule></span>
        <div class="ct__row">
          <span class="ct__label label" data-ct-label>{t.channels[c.id]}</span>
          <a class="ct__link" href={c.href} aria-label={c.parts.join('')} target={c.external ? '_blank' : undefined} rel={c.external ? 'noopener' : undefined} data-ct-link>
            <span class="ct__value">
              {c.parts.map((part) => (
                <span class="ct__clip" data-text={part}>
                  <span class="ct__part" aria-hidden="true" data-ct-part>{part}</span>
                </span>
              ))}
            </span>
            <span class="ct__arrow" aria-hidden="true">↗</span>
          </a>
          {c.id === 'email' && (
            <button class="ct__copy" type="button" aria-label={t.copy} title={t.copy} data-ct-copy={socials.email} hidden>
              <svg class="ct__copy-icon" viewBox="0 0 24 24" aria-hidden="true">
                <rect x="8" y="8" width="14" height="14" rx="2"></rect>
                <path d="M8 16H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v4"></path>
              </svg>
              <svg class="ct__copy-check" viewBox="0 0 24 24" aria-hidden="true">
                <path d="m5 12 4 4L19 6"></path>
              </svg>
            </button>
          )}
        </div>
      </li>
    ))}
    <li class="ct__channel ct__channel--end" aria-hidden="true">
      <span class="ct__rule" data-ct-rule></span>
    </li>
  </ul>
  <p class="sr-only" aria-live="polite" data-ct-status data-copied={t.copied}></p>
</section>

<script>
  import { initContact } from './contact';
  const root = document.querySelector<HTMLElement>('[data-contact]');
  if (root) initContact(root);
</script>

<style>
  .ct {
    /* The label column of the channel rows; the intro starts where their values do. */
    --label-col: 11rem;
    --label-gap: 2rem;
    position: relative;
    padding: clamp(6rem, 14vh, 10rem) var(--gutter) clamp(5rem, 12vh, 8rem);
  }
  .ct__head {
    display: grid;
    gap: clamp(1.25rem, 3vh, 2rem);
  }
  .ct__title {
    max-width: 14ch;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.75rem, 7vw, 7rem);
    line-height: 0.88;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .ct__text {
    max-width: 40rem;
    color: var(--paper-soft);
    font-size: var(--text-lead);
    line-height: 1.5;
    text-wrap: pretty;
  }
  @media (min-width: 768px) {
    .ct__text {
      margin-left: calc(var(--label-col) + var(--label-gap));
    }
  }
  /* Wide screens: the intro stands beside the title, on its baseline, instead of floating in a
     narrow column under its left half. */
  @media (min-width: 1200px) {
    .ct__head {
      grid-template-columns: minmax(0, 1fr) minmax(22rem, 34rem);
      align-items: end;
      column-gap: clamp(2rem, 5vw, 6rem);
    }
    .ct__text {
      margin-left: 0;
      /* Down to the title's baseline: its line box sits a little under the caps. */
      margin-bottom: 0.35rem;
    }
  }

  /* ── The channels ──────────────────────────────────── */
  .ct__channels {
    margin: clamp(3rem, 8vh, 5rem) 0 0;
    padding: 0;
    list-style: none;
  }
  .ct__rule {
    display: block;
    height: 1px;
    background: var(--hairline);
    transform-origin: 0 50%;
  }
  .ct__row {
    position: relative;
    display: grid;
    grid-template-areas:
      'label'
      'link'
      'copy';
    gap: 0.75rem;
    padding: clamp(1.25rem, 3vh, 2rem) 0;
  }
  .ct__label {
    grid-area: label;
    color: var(--paper-dim);
  }
  .ct__link {
    grid-area: link;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    min-width: 0;
  }
  .ct__value {
    display: flex;
    flex-wrap: wrap;
    min-width: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.9rem, 5.2vw, 5.5rem);
    line-height: 1;
  }
  /* The original text sizes the slot; wider scrambled glyphs cannot move its wrap point. */
  .ct__clip {
    position: relative;
    display: block;
    overflow: hidden;
  }
  .ct__clip::before {
    content: attr(data-text);
    display: block;
    padding-bottom: 0.2em;
    visibility: hidden;
  }
  /* Red ink is rolled across the value on hover: the fill sits off to the right of the text and
     slides under it. */
  .ct__part {
    position: absolute;
    inset: 0;
    white-space: nowrap;
    display: block;
    /* Room for descenders: the ink is clipped to this box, and the slot to its parent. */
    padding-bottom: 0.2em;
    background: linear-gradient(90deg, var(--red) 50%, var(--paper) 50%) 100% 0 / 200% 100% no-repeat;
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    transition: background-position 0.7s var(--ease-tear);
  }
  .ct__clip + .ct__clip .ct__part {
    transition-delay: 0.08s;
  }
  .ct__arrow {
    flex: none;
    font-size: clamp(1.5rem, 3vw, 2.75rem);
    line-height: 1;
    transition:
      transform 0.6s var(--ease-out),
      color 0.3s;
  }
  .ct__link:hover .ct__part,
  .ct__link:focus-visible .ct__part {
    background-position: 0 0;
  }
  .ct__link:hover .ct__arrow,
  .ct__link:focus-visible .ct__arrow {
    color: var(--red);
    transform: translate(0.25em, -0.25em);
  }
  .ct__link:focus-visible {
    outline-offset: 6px;
  }

  /* ── Copy the address ──────────────────────────────── */
  .ct__copy {
    grid-area: copy;
    justify-self: start;
    align-self: start;
    display: grid;
    place-items: center;
    width: var(--control-target);
    height: var(--control-target);
    border: 2px solid var(--hairline);
    border-radius: calc(var(--control-target) / 4);
    color: var(--paper-dim);
    cursor: pointer;
    transition:
      border-color 0.3s,
      color 0.3s;
  }
  .ct__copy[hidden] {
    display: none;
  }
  .ct__copy:hover,
  .ct__copy:focus-visible {
    border-color: var(--red);
    color: var(--red);
  }
  .ct__copy:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 4px;
  }
  .ct__copy-icon,
  .ct__copy-check {
    grid-area: 1 / 1;
    width: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: opacity 0.2s;
  }
  .ct__copy-check,
  .ct__copy[data-copied] .ct__copy-icon {
    opacity: 0;
  }
  .ct__copy[data-copied] .ct__copy-check {
    opacity: 1;
    color: var(--red);
  }
  @media (prefers-reduced-motion: reduce) {
    .ct__copy-icon,
    .ct__copy-check {
      transition: none;
    }
  }

  /* Wide: the label (and the copy button under it) in a column of their own, so every value and
     arrow lines up. */
  @media (min-width: 768px) {
    .ct__row {
      grid-template-columns: var(--label-col) minmax(0, 1fr);
      grid-template-areas:
        'label link'
        'copy link';
      grid-template-rows: auto 1fr;
      column-gap: var(--label-gap);
    }
    .ct__link {
      align-self: center;
    }
  }
</style>
