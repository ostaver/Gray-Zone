---
import type { Locale } from '../../i18n/config';
import { contactCopy, type ContactChannel } from '../../data/contact';
import { repo, socials } from '../../data/links';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = contactCopy[locale];
const [mailbox, domain] = socials.email.split('@');

// Each value is split where it may wrap, so a long address breaks at the @ and not mid-word.
const channels: { id: ContactChannel; href: string; parts: string[]; external: boolean }[] = [
  { id: 'email', href: `mailto:${socials.email}`, parts: [mailbox, `@${domain}`], external: false },
  { id: 'instagram', href: socials.instagram, parts: [`@${socials.instagramHandle}`], external: true },
  { id: 'github', href: repo, parts: [t.source], external: true },
  { id: 'issues', href: `${repo}/issues/new`, parts: [t.bugReport], external: true },
];
---

<section class="ct" id="contact" aria-labelledby="contact-title" data-contact>
  <header class="ct__head">
    <h2 class="ct__title" id="contact-title" data-ct-print>{t.title}</h2>
    <p class="ct__text" data-ct-print>{t.text}</p>
  </header>

  <ul class="ct__channels" role="list">
    {channels.map((c) => (
      <li class="ct__channel" data-ct-channel>
        <span class="ct__rule" aria-hidden="true" data-ct-rule></span>
        <div class="ct__row">
          <span class="ct__label label" data-ct-label>{t.channels[c.id]}</span>
          <a class="ct__link" href={c.href} target={c.external ? '_blank' : undefined} rel={c.external ? 'noopener' : undefined} data-ct-link>
            <span class="ct__value">
              {c.parts.map((part) => (
                <span class="ct__clip">
                  <span class="ct__part" data-ct-part>{part}</span>
                </span>
              ))}
            </span>
            <span class="ct__arrow" aria-hidden="true">↗</span>
          </a>
          {c.id === 'email' && (
            <div class="ct__copy-wrap">
              <button class="ct__copy" type="button" data-ct-copy={socials.email} hidden>
                <svg class="ct__copy-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <rect x="9" y="9" width="11" height="11" rx="1"></rect>
                  <path d="M15 9V4H4v11h5"></path>
                </svg>
                <span>{t.copy}</span>
              </button>
              <span class="ct__stamp" aria-hidden="true" data-ct-stamp>
                <span class="flap-board" data-flap>{t.copied}</span>
              </span>
            </div>
          )}
        </div>
      </li>
    ))}
    <li class="ct__channel ct__channel--end" aria-hidden="true">
      <span class="ct__rule" data-ct-rule></span>
    </li>
  </ul>
  <p class="sr-only" aria-live="polite" data-ct-status data-copied={t.copied}></p>
</section>

<script>
  import { initContact } from './contact';
  const root = document.querySelector<HTMLElement>('[data-contact]');
  if (root) initContact(root);
</script>

<style>
  .ct {
    /* The label column of the channel rows; the intro starts where their values do. */
    --label-col: 11rem;
    --label-gap: 2rem;
    position: relative;
    padding: clamp(6rem, 14vh, 10rem) var(--gutter) clamp(5rem, 12vh, 8rem);
  }
  .ct__head {
    display: grid;
    gap: clamp(1.25rem, 3vh, 2rem);
  }
  .ct__title {
    max-width: 14ch;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.75rem, 7vw, 7rem);
    line-height: 0.88;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .ct__text {
    max-width: 40rem;
    color: var(--paper-soft);
    font-size: var(--text-lead);
    line-height: 1.5;
    text-wrap: pretty;
  }
  @media (min-width: 768px) {
    .ct__text {
      margin-left: calc(var(--label-col) + var(--label-gap));
    }
  }
  /* Wide screens: the intro stands beside the title, on its baseline, instead of floating in a
     narrow column under its left half. */
  @media (min-width: 1200px) {
    .ct__head {
      grid-template-columns: minmax(0, 1fr) minmax(22rem, 34rem);
      align-items: end;
      column-gap: clamp(2rem, 5vw, 6rem);
    }
    .ct__text {
      margin-left: 0;
      /* Down to the title's baseline: its line box sits a little under the caps. */
      margin-bottom: 0.35rem;
    }
  }

  /* ── The channels ──────────────────────────────────── */
  .ct__channels {
    margin: clamp(3rem, 8vh, 5rem) 0 0;
    padding: 0;
    list-style: none;
  }
  .ct__rule {
    display: block;
    height: 1px;
    background: var(--hairline);
    transform-origin: 0 50%;
  }
  .ct__row {
    position: relative;
    display: grid;
    grid-template-areas:
      'label'
      'link'
      'copy';
    gap: 0.75rem;
    padding: clamp(1.25rem, 3vh, 2rem) 0;
  }
  .ct__label {
    grid-area: label;
    color: var(--paper-dim);
  }
  .ct__link {
    grid-area: link;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    min-width: 0;
  }
  .ct__value {
    display: flex;
    flex-wrap: wrap;
    min-width: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.9rem, 5.2vw, 5.5rem);
    line-height: 1;
  }
  /* Each part rises out of its own slot on the way in (contact.ts). */
  .ct__clip {
    display: block;
    overflow: hidden;
  }
  /* Red ink is rolled across the value on hover: the fill sits off to the right of the text and
     slides under it. */
  .ct__part {
    display: block;
    /* Room for descenders: the ink is clipped to this box, and the slot to its parent. */
    padding-bottom: 0.2em;
    background: linear-gradient(90deg, var(--red) 50%, var(--paper) 50%) 100% 0 / 200% 100% no-repeat;
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    transition: background-position 0.7s var(--ease-tear);
  }
  .ct__clip + .ct__clip .ct__part {
    transition-delay: 0.08s;
  }
  .ct__arrow {
    flex: none;
    font-size: clamp(1.5rem, 3vw, 2.75rem);
    line-height: 1;
    transition:
      transform 0.6s var(--ease-out),
      color 0.3s;
  }
  .ct__link:hover .ct__part,
  .ct__link:focus-visible .ct__part {
    background-position: 0 0;
  }
  .ct__link:hover .ct__arrow,
  .ct__link:focus-visible .ct__arrow {
    color: var(--red);
    transform: translate(0.25em, -0.25em);
  }
  .ct__link:focus-visible {
    outline-offset: 6px;
  }

  /* ── Copy the address ──────────────────────────────── */
  .ct__copy-wrap {
    grid-area: copy;
    position: relative;
    /* Flex, so the wrap is exactly the button's box (no line-box slack for the board to cover). */
    display: flex;
    justify-self: start;
  }
  /* A flat, hard-edged ticket: heavy rule, a red slab for a shadow. On hover red ink rolls across
     it left to right (the same gesture as the values), and the slab is pressed flat. */
  .ct__copy {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 2.75rem;
    padding: 0.7rem 1.2rem 0.7rem 1rem;
    border: 2px solid var(--paper);
    background: linear-gradient(90deg, var(--red) 50%, var(--ink) 50%) 100% 0 / 200% 100% no-repeat;
    box-shadow: 5px 5px 0 var(--red);
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-position 0.6s var(--ease-tear),
      box-shadow 0.3s var(--ease-out),
      border-color 0.3s,
      color 0.3s;
  }
  .ct__copy[hidden] {
    display: none;
  }
  .ct__copy:hover,
  .ct__copy:focus-visible {
    background-position: 0 0;
    border-color: var(--red);
    box-shadow: 0 0 0 var(--red);
    color: var(--button-hover-text);
  }
  .ct__copy:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 5px;
  }
  .ct__copy-icon {
    width: 1.15rem;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: translate 0.4s var(--ease-out);
  }
  .ct__copy:hover .ct__copy-icon,
  .ct__copy:focus-visible .ct__copy-icon {
    translate: -2px -2px;
  }
  /* Once the address is on the clipboard the button's face is covered by a split-flap board
     (styles/flap.css) that clatters out "copied", in the button's own frame. */
  .ct__stamp {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border: 2px solid var(--paper);
    background: var(--ink);
    box-shadow: 5px 5px 0 var(--red);
    font-size: 1.3rem;
    opacity: 0;
    pointer-events: none;
  }
  .ct__stamp[data-on] {
    opacity: 1;
  }

  /* Wide: the label (and the copy button under it) in a column of their own, so every value and
     arrow lines up. */
  @media (min-width: 768px) {
    .ct__row {
      grid-template-columns: var(--label-col) minmax(0, 1fr);
      grid-template-areas:
        'label link'
        'copy link';
      grid-template-rows: auto 1fr;
      column-gap: var(--label-gap);
    }
    .ct__link {
      align-self: center;
    }
    .ct__copy-wrap {
      align-self: start;
    }
  }
</style>
