---
import { getImage } from 'astro:assets';
import logo from '../../assets/brand/logo.png';

const logoImg = await getImage({ src: logo, width: 160, format: 'webp' });
// Progress dots; the first half takes the logo's red, the second its cream.
const barDots = 16;
---

<div class="pre" data-preloader data-logo={logoImg.src}>
  <div class="pre__veil" aria-hidden="true"></div>
  <canvas class="pre__dots" aria-hidden="true"></canvas>
  <div class="pre__bar" aria-hidden="true">
    {Array.from({ length: barDots }, (_, i) => <i class:list={{ 'is-honest': i < barDots / 2 }} style={`--i:${i}`}></i>)}
  </div>
</div>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-preloader]');
    if (!root || document.documentElement.dataset.preload === 'none') return;
    root.setAttribute('data-blocking', '');
    let timer;
    const previousOverflow = document.documentElement.style.overflow;
    document.documentElement.style.overflow = 'hidden';
    const block = () => {
      if (!root.hasAttribute('data-blocking')) return;
      document.querySelectorAll('header, main, footer').forEach((el) => {
        if (el.hasAttribute('inert')) return;
        el.setAttribute('data-preload-inert', '');
        el.setAttribute('inert', '');
      });
    };
    const observer = new MutationObserver(block);
    observer.observe(document.documentElement, { childList: true, subtree: true });
    const release = () => {
      clearTimeout(timer);
      observer.disconnect();
      document.documentElement.style.overflow = previousOverflow;
      document.removeEventListener('DOMContentLoaded', block);
      root.removeAttribute('data-blocking');
      root.style.pointerEvents = 'none';
      document.querySelectorAll('[data-preload-inert]').forEach((el) => {
        el.removeAttribute('inert');
        el.removeAttribute('data-preload-inert');
      });
      document.documentElement.setAttribute('data-app-ready', '');
    };
    const skip = () => {
      release();
      root.remove();
      window.dispatchEvent(new Event('grayzone:ready'));
      window.dispatchEvent(new Event('grayzone:preload-skip'));
    };
    window.addEventListener('grayzone:ready', release, { once: true });
    document.addEventListener('DOMContentLoaded', block, { once: true });
    block();
    // Failsafe for a module script that never starts; once it is live it owns its own watchdog.
    timer = setTimeout(() => {
      if (!root.hasAttribute('data-live')) skip();
    }, 6000);
  })();
</script>

<script>
  import { gsap } from '../../lib/motion/gsap';
  import { lockScroll } from '../../lib/motion/scroll';
  import { assetProgress, assetsSettled, signalReady, trackAsset, onCleanup } from '../../lib/lifecycle';
  import { LogoParticles } from '../../lib/canvas/logoParticles';

  const root = document.querySelector<HTMLElement>('[data-preloader]');
  if (!root || !root.hasAttribute('data-blocking')) {
    root?.remove();
    signalReady();
  } else {
    lockScroll(true);
    let held = true;
    let stopped = false;
    let dots: LogoParticles | null = null;
    let watchdog = 0;
    let exit: gsap.core.Timeline | null = null;
    const canvas = root.querySelector<HTMLCanvasElement>('canvas')!;
    const bar = root.querySelector<HTMLElement>('.pre__bar')!;
    const barDots = [...bar.children] as HTMLElement[];
    const layout = () => {
      dots?.layout();
      if (!dots) return;
      root.style.setProperty('--logo', `${dots.size}px`);
      root.style.setProperty('--cell', `${dots.cell}px`);
    };
    const release = () => {
      if (!held) return;
      held = false;
      lockScroll(false);
    };
    const short = document.documentElement.dataset.preload === 'short';
    // Progress = real work (tracked assets + fonts), paced by a minimum duration so the bar
    // glides instead of snapping, and never claims 100% before the work is done.
    let workDone = false;
    let shown = 0;
    let start = 0;
    let resolveFilled: () => void = () => {};
    const filled = new Promise<void>((resolve) => (resolveFilled = resolve));
    const minDuration = short ? 0.7 : 1.3;
    const tick = (time: number, deltaMs: number) => {
      dots?.draw();
      const paced = Math.min(1, (time - start) / minDuration);
      const target = Math.min(paced, workDone ? 1 : assetProgress() * 0.9);
      shown += (target - shown) * (1 - Math.exp((-deltaMs / 1000) * 6));
      if (target === 1 && shown > 0.997) {
        shown = 1;
        resolveFilled();
      }
      bar.style.setProperty('--p', (shown * barDots.length).toFixed(3));
    };
    const cleanup = () => {
      if (stopped) return;
      clearTimeout(watchdog);
      stopped = true;
      exit?.kill();
      gsap.ticker.remove(tick);
      gsap.killTweensOf([bar, ...barDots]);
      if (dots) gsap.killTweensOf(dots);
      dots?.dispose();
      window.removeEventListener('resize', layout);
      window.removeEventListener('grayzone:preload-skip', cleanup);
      window.removeEventListener('grayzone:ready', release);
      root.remove();
      release();
    };
    window.addEventListener('grayzone:preload-skip', cleanup);
    window.addEventListener('grayzone:ready', release);
    watchdog = window.setTimeout(() => {
      cleanup();
      signalReady();
    }, 5500);
    const finish = () => {
      clearTimeout(watchdog);
      cleanup();
    };
    onCleanup(finish);
    void (async () => {
      trackAsset(document.fonts.ready);
      const img = new Image();
      img.src = root.dataset.logo ?? '';
      await img.decode().catch(() => {});
      if (stopped) return;
      // The script is alive and running: the inline failsafe must not cut the sequence short.
      root.setAttribute('data-live', '');
      dots = img.naturalWidth ? new LogoParticles(canvas, img) : null;
      layout();
      window.addEventListener('resize', layout);
      void assetsSettled(3500).then(() => (workDone = true));
      start = gsap.ticker.time;
      gsap.ticker.add(tick);

      gsap.from(bar, { opacity: 0, duration: 1.4, delay: short ? 0 : 0.5, ease: 'power2.out' });
      gsap.from(barDots, { scale: 0, duration: 0.7, delay: short ? 0 : 0.5, ease: 'back.out(2)', stagger: { each: 0.035, from: 'center' } });
      if (dots) gsap.fromTo(dots, { assemble: short ? 1.5 : 0 }, { assemble: 1.5, duration: short ? 0.01 : 1.8, ease: 'power2.inOut' });

      await filled;
      if (stopped) return;
      // The load is done; from here only the exit plays, so the load watchdog steps aside.
      clearTimeout(watchdog);

      // Exit, one overlapping gesture: the progress dots gather into the tear between their
      // halves; the logo turns one full revolution while it swells past the viewer, its dots
      // thinning out and then bursting outward from the centre off the screen, over the hero,
      // whose field develops from the centre. The turn lands upright, so the logo's tear hands
      // over to the hero's seam.
      const pitch = barDots[1].offsetLeft - barDots[0].offsetLeft;
      exit = gsap.timeline({ onComplete: finish });
      exit.to(barDots, { x: (i: number) => ((barDots.length - 1) / 2 - i) * pitch, opacity: 0, duration: 0.8, ease: 'power2.in', stagger: { each: 0.015, from: 'edges' } }, 0);
      if (dots) {
        exit.to(dots, { rotation: 360, duration: 2.6, ease: 'sine.inOut' }, 0.25).to(dots, { zoom: 6.5, duration: 2.4, ease: 'power2.in' }, 0.45);
        // Linear: the shader squares it, so the dots accelerate away. All are off-screen at 1,
        // which is why the canvas needs no fade.
        exit.to(dots, { scatter: 1, duration: 1.5, ease: 'none' }, 1.3);
      }
      exit.add(signalReady, 1.15).to(root.querySelector('.pre__veil'), { opacity: 0, duration: 1.6, ease: 'sine.inOut' }, 1.05);
    })().catch((error: unknown) => {
      console.error('[preloader]', error);
      finish();
      signalReady();
    });
  }
</script>

<style>
  .pre {
    --logo: min(60vw, 38vh, 360px);
    --cell: calc(var(--logo) / 60);
    position: fixed;
    inset: 0;
    z-index: var(--z-preloader);
    pointer-events: none;
    display: none;
  }
  .pre[data-blocking],
  .pre:has(.pre__veil[style]) {
    display: block;
  }
  .pre[data-blocking] {
    pointer-events: auto;
  }
  :global(.no-js) .pre,
  :global([data-preload='none']) .pre {
    display: none;
  }

  .pre__veil {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 120% 95% at 50% 50%, transparent 38%, rgb(0 0 0 / 0.72) 100%),
      radial-gradient(ellipse 70% 60% at 50% 48%, #151313 0%, var(--ink) 62%);
  }
  /* White zone: lit paper instead of a dark pool, one long falloff to warm gray at the edges
     (no second, banded ring), and a cooler ember. */
  :global(:root[data-zone='white']) .pre__veil {
    background: radial-gradient(ellipse 125% 110% at 50% 46%, #fff 0%, var(--ink) 34%, #ece9e3 72%, #d9d5cd 100%);
  }
  :global(:root[data-zone='white']) .pre__veil::before {
    background: radial-gradient(circle, rgb(227 38 31 / 0.1), rgb(227 38 31 / 0.03) 42%, transparent 68%);
  }
  /* A faint ember behind the logo, breathing slowly. */
  .pre__veil::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: calc(var(--logo) * 2.4);
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(227 38 31 / 0.13), rgb(227 38 31 / 0.04) 40%, transparent 68%);
    animation: pre-breathe 3.2s ease-in-out infinite alternate;
  }
  @keyframes pre-breathe {
    from { opacity: 0.55; scale: 0.94; }
    to { opacity: 1; scale: 1.04; }
  }

  .pre__dots {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .pre__bar {
    position: absolute;
    left: 50%;
    top: calc(50% + var(--logo) / 2 + clamp(1.75rem, 5vh, 3rem));
    display: flex;
    gap: calc(var(--cell) * 1.3);
    translate: -50% -50%;
  }
  /* One dot per step, on the logo's own grid (a pitch of two cells). A dot lights as the
     progress passes it, in its half's colour; the one being filled swells and glows, so the
     leading edge reads as a single travelling spark. State lives on ::before; the <i> is
     left to GSAP's intro/exit motion. */
  .pre__bar i {
    --c: var(--paper);
    --lit: clamp(0, var(--p, 0) - var(--i), 1);
    --head: calc(var(--lit) * (1 - var(--lit)) * 4);
    width: calc(var(--cell) * 0.7);
    aspect-ratio: 1;
  }
  .pre__bar i::before {
    content: '';
    display: block;
    height: 100%;
    border-radius: 50%;
    background: var(--c);
    opacity: calc(0.16 + 0.84 * var(--lit));
    scale: calc(1 + 0.6 * var(--head));
    box-shadow: 0 0 calc(var(--cell) * 1.8) color-mix(in srgb, var(--c) calc(var(--head) * 80%), transparent);
  }
  .pre__bar .is-honest {
    --c: var(--red);
  }
</style>
