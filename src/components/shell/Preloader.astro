---
import { getImage } from 'astro:assets';
import logo from '../../assets/brand/logo.png';
import type { Locale } from '../../i18n/config';
import { ui } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale].preloader;
const logoImg = await getImage({ src: logo, width: 160, format: 'webp' });

// Deterministic torn line through the logo's own tear (x ≈ 50%). Shared by the SVG stroke,
// both panel clip-paths and the particle side test, so everything rips along one edge.
let seed = 11;
const rand = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
const rows = 42;
const tear: [number, number][] = [];
for (let i = 0, x = 50; i <= rows; i++) {
  x = 50 + (x - 50) * 0.7 + (rand() - 0.5) * 2.6;
  tear.push([+x.toFixed(2), +((i / rows) * 100).toFixed(2)]);
}
const tearPath = `M${tear.map(([x, y]) => `${x} ${y}`).join(' L')}`;
// Extend the ends past the viewport so rotated panels never expose a corner.
const tearPts = tear.map(([x, y]) => `${x}% ${y === 0 ? -10 : y === 100 ? 110 : y}%`).join(',');
const leftClip = `polygon(-10% -10%, ${tearPts}, -10% 110%)`;
const rightClip = `polygon(110% -10%, ${tearPts}, 110% 110%)`;
---

<div class="pre" data-preloader data-logo={logoImg.src} data-tear={JSON.stringify(tear)} aria-hidden="true">
  <div class="pre__panel pre__panel--l" style={`clip-path:${leftClip}`}></div>
  <div class="pre__panel pre__panel--r" style={`clip-path:${rightClip}`}></div>
  <canvas class="pre__dots"></canvas>
  <svg class="pre__tear" viewBox="0 0 100 100" preserveAspectRatio="none">
    <path d={tearPath} pathLength="1"></path>
  </svg>

  <div class="pre__row pre__row--top label">
    <span class="line-mask"><span data-pre-out>{t.label}</span></span>
    <span class="line-mask"><span data-pre-out>{t.meta}</span></span>
  </div>
  <div class="pre__row pre__row--bottom">
    <span class="line-mask label"><span data-pre-out>{t.loading}</span></span>
    <span class="line-mask pre__count"><span data-pre-out data-pre-count>000</span></span>
  </div>
</div>

<script>
  import { gsap } from '../../lib/motion/gsap';
  import { lockScroll } from '../../lib/motion/scroll';
  import { assetsSettled, signalReady } from '../../lib/lifecycle';
  import { LogoParticles } from '../../lib/canvas/logoParticles';

  const root = document.querySelector<HTMLElement>('[data-preloader]');
  const mode = document.documentElement.dataset.preload;

  if (!root) {
    signalReady();
  } else if (mode === 'none') {
    root.remove();
    signalReady();
  } else {
    // The script is alive: switch off the CSS failsafe that would otherwise hide the overlay.
    root.dataset.live = '';
    run(root, mode === 'short').catch((error: unknown) => {
      // Never trap the visitor behind the overlay: drop it and let the page intro run.
      console.error('[preloader]', error);
      root.remove();
      lockScroll(false);
      signalReady();
    });
  }

  async function run(root: HTMLElement, short: boolean) {
    lockScroll(true);
    const tear: [number, number][] = JSON.parse(root.dataset.tear ?? '[]');
    const tearAt = (y: number) => {
      const f = Math.min(1, Math.max(0, y)) * (tear.length - 1);
      const i = Math.floor(f);
      const [a] = tear[i];
      const [b] = tear[Math.min(i + 1, tear.length - 1)];
      return (a + (b - a) * (f - i)) / 100;
    };

    const canvas = root.querySelector<HTMLCanvasElement>('.pre__dots')!;
    const count = root.querySelector<HTMLElement>('[data-pre-count]')!;
    const outs = root.querySelectorAll<HTMLElement>('[data-pre-out]');
    const path = root.querySelector<SVGPathElement>('.pre__tear path')!;

    const img = new Image();
    img.src = root.dataset.logo ?? '';
    await img.decode().catch(() => undefined);

    const dots = img.naturalWidth ? new LogoParticles(canvas, img, tearAt) : null;
    const draw = () => dots?.draw();
    gsap.ticker.add(draw);
    const onResize = () => dots?.layout();
    window.addEventListener('resize', onResize);

    const counter = { v: 0 };
    const writeCount = () => (count.textContent = String(Math.round(counter.v)).padStart(3, '0'));

    gsap.from(outs, { yPercent: 110, duration: 0.9, stagger: 0.05 });
    const intro = gsap.timeline();
    if (dots) intro.fromTo(dots, { assemble: short ? 1.5 : 0 }, { assemble: 1.5, duration: short ? 0.01 : 1.7, ease: 'power2.inOut' }, 0);
    intro.to(counter, { v: 86, duration: short ? 0.4 : 1.6, ease: 'power2.inOut', onUpdate: writeCount }, 0);

    await Promise.all([intro.then(), assetsSettled(), document.fonts.ready]);

    const exit = gsap.timeline({
      onComplete: () => {
        gsap.ticker.remove(draw);
        window.removeEventListener('resize', onResize);
        root.remove();
        lockScroll(false);
      },
    });
    exit
      .to(counter, { v: 100, duration: 0.35, ease: 'power2.out', onUpdate: writeCount })
      .to(outs, { yPercent: -110, opacity: 0, duration: 0.6, stagger: 0.04, ease: 'expo.in' }, '+=0.05')
      .fromTo(path, { drawSVG: '0% 0%' }, { drawSVG: '0% 100%', duration: 0.55, ease: 'power3.inOut' }, '<0.2')
      .add(signalReady)
      .to('.pre__panel--l', { yPercent: -104, xPercent: -2, rotation: -2.5, duration: 1.2, ease: 'tear' }, '+=0.02')
      .to('.pre__panel--r', { yPercent: 104, xPercent: 2, rotation: 2.5, duration: 1.2, ease: 'tear' }, '<')
      .to(dots ?? {}, { split: 1, duration: 1.2, ease: 'tear' }, '<')
      .to(path, { opacity: 0, duration: 0.3 }, '<0.15');
  }
</script>

<style>
  .pre {
    position: fixed;
    inset: 0;
    z-index: var(--z-preloader);
    color: var(--paper);
    pointer-events: auto;
    /* Failsafe: if the preloader script never starts (blocked, failed to load), fade the
       overlay out on its own. The script sets [data-live] on start, which cancels this. */
    animation: pre-failsafe 0.6s ease 6s forwards;
  }
  .pre[data-live] {
    animation: none;
  }
  @keyframes pre-failsafe {
    to {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
  }
  :global(.no-js) .pre,
  :global([data-preload='none']) .pre {
    display: none;
  }
  .pre__panel {
    position: absolute;
    inset: 0;
    background: var(--ink);
    will-change: transform;
  }
  .pre__panel--l {
    transform-origin: 50% 100%;
  }
  .pre__panel--r {
    transform-origin: 50% 0%;
  }
  .pre__dots {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .pre__tear {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .pre__tear path {
    fill: none;
    stroke: var(--paper);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 0 1;
  }
  .pre__row {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
  }
  .pre__row--top {
    top: var(--gutter);
    color: var(--ash);
  }
  .pre__row--bottom {
    bottom: var(--gutter);
  }
  .pre__count {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(3rem, 9vw, 7.5rem);
    line-height: 0.85;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
  }
</style>
