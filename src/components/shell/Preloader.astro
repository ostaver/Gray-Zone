---
import { getImage } from 'astro:assets';
import logo from '../../assets/brand/logo.png';

const logoImg = await getImage({ src: logo, width: 160, format: 'webp' });
// Progress dots; the first half takes the logo's red, the second its cream.
const barDots = 16;
---

<div class="pre" data-preloader data-logo={logoImg.src}>
  <div class="pre__veil" aria-hidden="true"></div>
  <canvas class="pre__dots" aria-hidden="true"></canvas>
  <div class="pre__bar" aria-hidden="true">
    {Array.from({ length: barDots }, (_, i) => <i class:list={{ 'is-honest': i < barDots / 2 }} style={`--i:${i}`}></i>)}
  </div>
</div>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-preloader]');
    if (!root || document.documentElement.dataset.preload === 'none') return;
    root.setAttribute('data-blocking', '');
    let timer;
    const previousOverflow = document.documentElement.style.overflow;
    document.documentElement.style.overflow = 'hidden';
    const block = () => {
      if (!root.hasAttribute('data-blocking')) return;
      document.querySelectorAll('header, main, footer').forEach((el) => {
        if (el.hasAttribute('inert')) return;
        el.setAttribute('data-preload-inert', '');
        el.setAttribute('inert', '');
      });
    };
    const observer = new MutationObserver(block);
    observer.observe(document.documentElement, { childList: true, subtree: true });
    const release = () => {
      clearTimeout(timer);
      observer.disconnect();
      document.documentElement.style.overflow = previousOverflow;
      document.removeEventListener('DOMContentLoaded', block);
      root.removeAttribute('data-blocking');
      root.style.pointerEvents = 'none';
      document.querySelectorAll('[data-preload-inert]').forEach((el) => {
        el.removeAttribute('inert');
        el.removeAttribute('data-preload-inert');
      });
      document.documentElement.setAttribute('data-app-ready', '');
    };
    const skip = () => {
      release();
      root.remove();
      window.dispatchEvent(new Event('grayzone:ready'));
      window.dispatchEvent(new Event('grayzone:preload-skip'));
    };
    window.addEventListener('grayzone:ready', release, { once: true });
    document.addEventListener('DOMContentLoaded', block, { once: true });
    block();
    timer = setTimeout(skip, 6000);
  })();
</script>

<script>
  import { gsap } from '../../lib/motion/gsap';
  import { lockScroll } from '../../lib/motion/scroll';
  import { assetProgress, assetsSettled, signalReady, trackAsset, onCleanup } from '../../lib/lifecycle';
  import { LogoParticles } from '../../lib/canvas/logoParticles';

  const root = document.querySelector<HTMLElement>('[data-preloader]');
  if (!root || !root.hasAttribute('data-blocking')) {
    root?.remove();
    signalReady();
  } else {
    lockScroll(true);
    let held = true;
    let stopped = false;
    let dots: LogoParticles | null = null;
    let watchdog = 0;
    let exit: gsap.core.Timeline | null = null;
    const canvas = root.querySelector<HTMLCanvasElement>('canvas')!;
    const bar = root.querySelector<HTMLElement>('.pre__bar')!;
    const barDots = [...bar.children] as HTMLElement[];
    const layout = () => {
      dots?.layout();
      if (!dots) return;
      root.style.setProperty('--logo', `${dots.size}px`);
      root.style.setProperty('--cell', `${dots.cell}px`);
    };
    const release = () => {
      if (!held) return;
      held = false;
      lockScroll(false);
    };
    const tick = () => {
      dots?.draw();
      bar.style.setProperty('--p', String(assetProgress() * barDots.length));
    };
    const cleanup = () => {
      if (stopped) return;
      clearTimeout(watchdog);
      stopped = true;
      exit?.kill();
      gsap.ticker.remove(tick);
      gsap.killTweensOf(barDots);
      if (dots) gsap.killTweensOf(dots);
      dots?.dispose();
      window.removeEventListener('resize', layout);
      window.removeEventListener('grayzone:preload-skip', cleanup);
      window.removeEventListener('grayzone:ready', release);
      root.remove();
      release();
    };
    window.addEventListener('grayzone:preload-skip', cleanup);
    window.addEventListener('grayzone:ready', release);
    watchdog = window.setTimeout(() => {
      cleanup();
      signalReady();
    }, 5500);
    const finish = () => {
      clearTimeout(watchdog);
      cleanup();
    };
    onCleanup(finish);
    void (async () => {
      trackAsset(document.fonts.ready);
      const img = new Image();
      img.src = root.dataset.logo ?? '';
      trackAsset(img.decode().catch(() => {}));
      await assetsSettled(3500);
      if (stopped) return;
      dots = img.naturalWidth ? new LogoParticles(canvas, img) : null;
      layout();
      window.addEventListener('resize', layout);
      gsap.ticker.add(tick);
      if (dots) dots.assemble = 1.5;
      exit = gsap.timeline({ onComplete: finish });
      exit.to(barDots, { opacity: 0, scale: 0, duration: 0.35, stagger: { each: 0.015, from: 'edges' } }, 0);
      if (dots) {
        exit.to(dots, { rotation: 360, zoom: 6.5, duration: 1.8, ease: 'sine.inOut' }, 0)
          .to(dots, { scatter: 1, duration: 1.1, ease: 'none' }, 0.6);
      }
      exit.to(root.querySelector('.pre__veil'), { opacity: 0, duration: 0.8 }, 0.15)
        .add(signalReady, 0.65);
    })().catch((error: unknown) => {
      console.error('[preloader]', error);
      finish();
      signalReady();
    });
  }
</script>

<style>
  .pre {
    --logo: min(60vw, 38vh, 360px);
    --cell: calc(var(--logo) / 60);
    position: fixed;
    inset: 0;
    z-index: var(--z-preloader);
    pointer-events: none;
    display: none;
  }
  .pre[data-blocking],
  .pre:has(.pre__veil[style]) {
    display: block;
  }
  .pre[data-blocking] {
    pointer-events: auto;
  }
  :global(.no-js) .pre,
  :global([data-preload='none']) .pre {
    display: none;
  }

  .pre__veil {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 120% 95% at 50% 50%, transparent 38%, rgb(0 0 0 / 0.72) 100%),
      radial-gradient(ellipse 70% 60% at 50% 48%, #151313 0%, var(--ink) 62%);
  }
  /* A faint ember behind the logo, breathing slowly. */
  .pre__veil::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: calc(var(--logo) * 2.4);
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(227 38 31 / 0.13), rgb(227 38 31 / 0.04) 40%, transparent 68%);
    animation: pre-breathe 3.2s ease-in-out infinite alternate;
  }
  @keyframes pre-breathe {
    from { opacity: 0.55; scale: 0.94; }
    to { opacity: 1; scale: 1.04; }
  }

  .pre__dots {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .pre__bar {
    position: absolute;
    left: 50%;
    top: calc(50% + var(--logo) / 2 + clamp(1.75rem, 5vh, 3rem));
    display: flex;
    gap: calc(var(--cell) * 1.3);
    translate: -50% -50%;
  }
  /* One dot per step, on the logo's own grid (a pitch of two cells). A dot lights as the
     progress passes it, in its half's colour; the one being filled swells and glows, so the
     leading edge reads as a single travelling spark. State lives on ::before; the <i> is
     left to GSAP's intro/exit motion. */
  .pre__bar i {
    --c: var(--paper);
    --lit: clamp(0, var(--p, 0) - var(--i), 1);
    --head: calc(var(--lit) * (1 - var(--lit)) * 4);
    width: calc(var(--cell) * 0.7);
    aspect-ratio: 1;
  }
  .pre__bar i::before {
    content: '';
    display: block;
    height: 100%;
    border-radius: 50%;
    background: var(--c);
    opacity: calc(0.16 + 0.84 * var(--lit));
    scale: calc(1 + 0.6 * var(--head));
    box-shadow: 0 0 calc(var(--cell) * 1.8) color-mix(in srgb, var(--c) calc(var(--head) * 80%), transparent);
  }
  .pre__bar .is-honest {
    --c: var(--red);
  }
</style>
