---
import type { Locale } from '../../i18n/config';
import { ui } from '../../i18n/ui';
import { sections } from '../../data/sections';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const nav = ui[locale].nav;
---

<!-- Stands in for the browser's scrollbar on mouse-driven screens: a ruler down the right edge,
     a mark per section, and a red thumb that stretches like liquid when the page moves fast.
     Decoration for pointers only; keys, wheel and the nav still do the real work. -->
<div class="rail" aria-hidden="true" data-rail>
  <div class="rail__track" data-rail-track>
    <span class="rail__ruler"></span>
    {sections.map((id, i) => (
      <span class="rail__mark" data-rail-mark={id}>
        <span class="rail__name">{nav[id]}</span>
        <span class="rail__num">{String(i + 1).padStart(2, '0')}</span>
        <span class="rail__tick"></span>
      </span>
    ))}
    <span class="rail__thumb" data-rail-thumb>
      <span class="rail__goo" data-rail-goo></span>
      <span class="rail__read label" data-rail-read>00</span>
    </span>
  </div>
</div>

<script>
  import { initScrollRail } from './scrollRail';
  const root = document.querySelector<HTMLElement>('[data-rail]');
  if (root) initScrollRail(root);
</script>

<style>
  .rail {
    position: fixed;
    top: calc(var(--nav-h) + 1rem);
    right: 0;
    bottom: 1.25rem;
    z-index: var(--z-nav);
    width: 1.75rem;
    /* Pointer screens only: touch keeps the system's own overlay scrollbar. */
    display: none;
    opacity: 0.45;
    transition: opacity 0.6s var(--ease-out);
    touch-action: none;
    user-select: none;
  }
  @media (hover: hover) and (pointer: fine) {
    :global(html.js) .rail {
      display: block;
    }
  }
  /* Nothing to scroll (the 404), or a lock holds the page (preloader, dialog). */
  .rail[data-empty] {
    display: none !important;
  }
  .rail[data-awake],
  .rail:hover {
    opacity: 1;
  }

  .rail__track {
    position: absolute;
    inset: 0;
    cursor: pointer;
  }
  /* The spine: a hairline, with a ruler's fine ticks that come up while the rail is in use. */
  .rail__track::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0.75rem;
    width: 1px;
    background: var(--hairline);
  }
  .rail__ruler {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0.75rem;
    width: 0.3rem;
    background: repeating-linear-gradient(to bottom, var(--paper-dim) 0 1px, transparent 1px 0.6rem);
    opacity: 0;
    transform: scaleX(0);
    transform-origin: right center;
    mask: linear-gradient(transparent, #000 8%, #000 92%, transparent);
    transition:
      opacity 0.4s,
      transform 0.6s var(--ease-out);
  }
  .rail[data-awake] .rail__ruler,
  .rail:hover .rail__ruler {
    opacity: 0.45;
    transform: none;
  }

  /* ── Sections ──────────────────────────────────────── */
  .rail__mark {
    position: absolute;
    top: 0;
    right: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    height: 1.25rem;
    margin-top: -0.625rem;
    color: var(--paper-dim);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    transition: color 0.3s;
  }
  .rail__mark[hidden] {
    display: none;
  }
  .rail__tick {
    width: 0.5rem;
    height: 1px;
    background: currentColor;
    transition: width 0.5s var(--ease-out);
  }
  .rail__num {
    font-variant-numeric: tabular-nums;
    opacity: 0;
    transform: translateX(0.35rem);
    transition:
      opacity 0.3s,
      transform 0.5s var(--ease-out);
  }
  /* Names come out on hover, plated so they read over imagery and the WebGL scenes. */
  .rail__name {
    padding: 0.2rem 0.4rem;
    background: rgb(var(--surface-rgb) / 0.85);
    opacity: 0;
    transform: translateX(0.75rem);
    transition:
      opacity 0.3s,
      transform 0.5s var(--ease-out);
  }
  .rail[data-awake] .rail__num,
  .rail:hover .rail__num,
  .rail:hover .rail__name {
    opacity: 1;
    transform: none;
  }
  .rail__mark[data-current] {
    color: var(--red);
  }
  .rail__mark[data-current] .rail__tick,
  .rail__mark:hover .rail__tick {
    width: 0.9rem;
  }
  .rail__mark:hover {
    color: var(--paper);
  }

  /* ── The thumb ─────────────────────────────────────── */
  .rail__thumb {
    position: absolute;
    top: 0;
    right: calc(0.75rem - 3px);
    width: 7px;
    height: var(--thumb-h, 3rem);
    cursor: grab;
    will-change: transform;
  }
  /* A wider hit area than the drawn bar. */
  .rail__thumb::before {
    content: '';
    position: absolute;
    inset: 0 -0.6rem;
  }
  .rail__goo {
    position: absolute;
    inset: 0;
    /* A hard-edged block, like the site's torn slabs; no pill. */
    background: var(--red);
    /* scrollRail.ts owns the transform (the stretch); hover widens through `scale`, which
       composes with it. */
    transition: scale 0.4s var(--ease-out);
  }
  .rail:hover .rail__goo,
  .rail[data-drag] .rail__goo {
    scale: 1.5 1;
  }
  .rail[data-drag] .rail__thumb {
    cursor: grabbing;
  }
  /* How far down the page, beside the thumb; only while the rail is in use. */
  .rail__read {
    position: absolute;
    top: 50%;
    right: calc(100% + 0.6rem);
    padding: 0.15rem 0.35rem;
    background: var(--red);
    color: var(--button-hover-text);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
    opacity: 0;
    translate: 0.4rem -50%;
    transition:
      opacity 0.3s,
      translate 0.5s var(--ease-out);
  }
  .rail[data-drag] .rail__read,
  .rail__thumb:hover .rail__read {
    opacity: 1;
    translate: 0 -50%;
  }
</style>
