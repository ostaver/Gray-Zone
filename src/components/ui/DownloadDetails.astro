---
import type { Locale } from '../../i18n/config';
import { ui } from '../../i18n/ui';
import { downloadCopy, downloadDate, exportPresetSource } from '../../data/download';
import { releaseAssets, releaseDate, releaseNotes } from '../../data/links';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = downloadCopy[locale];
const platformNames = ui[locale].download.platforms;
const platforms = ['windows', 'mac'] as const;
---
<div class="download-details" data-download-details>
  <p>{t.released} <time datetime={releaseDate}>{downloadDate(locale)}</time> · <a href={releaseNotes} target="_blank" rel="noopener">{t.notes}</a></p>
  <p data-download-phone hidden>{t.mobile}</p>
  <p data-download-unsupported hidden>{t.unsupported}</p>
  <div class="download-details__sharing" data-page-sharing data-copied={t.copied} data-shared={t.shared} data-failed={t.copyFailed} hidden>
    <div class="download-details__actions">
      <button type="button" data-page-copy>{t.copy}</button>
      <button type="button" data-page-share hidden>{t.share}</button>
    </div>
    <label>{t.pageLink}<input type="url" readonly data-page-link /></label>
    <p role="status" aria-live="polite" data-page-status></p>
  </div>
  <details>
    <summary>{t.install}</summary>
    {platforms.map((platform) => (
      <section>
        <h3>{platformNames[platform]}</h3>
        <p>{t.requirements[platform]}</p>
        <ol>{t.steps[platform].map((step) => <li>{step}</li>)}</ol>
      </section>
    ))}
    <p>{t.unspecified}</p>
    <p>{t.security}</p>
    <p><a href={exportPresetSource} target="_blank" rel="noopener">{t.source}</a></p>
    <h3>{t.checksum}</h3>
    {platforms.map((platform) => (
      <p>{releaseAssets[platform].file} · {releaseAssets[platform].bytes.toLocaleString(locale === 'mk' ? 'mk-MK' : 'en-US')} {t.bytes}<br /><code>{releaseAssets[platform].sha256}</code></p>
    ))}
  </details>
</div>
<script>
  import { detectPlatform, isMobileDevice } from '../../lib/platform';
  import { onCleanup } from '../../lib/lifecycle';
  for (const root of document.querySelectorAll<HTMLElement>('[data-download-details]')) {
    const phone = isMobileDevice();
    root.querySelector<HTMLElement>('[data-download-phone]')!.hidden = !phone;
    root.querySelector<HTMLElement>('[data-download-unsupported]')!.hidden = phone || detectPlatform() !== null;
    const sharing = root.querySelector<HTMLElement>('[data-page-sharing]')!;
    sharing.hidden = false;
    const events = new AbortController();
    onCleanup(() => events.abort());
    const input = sharing.querySelector<HTMLInputElement>('[data-page-link]')!;
    const status = sharing.querySelector<HTMLElement>('[data-page-status]')!;
    const share = sharing.querySelector<HTMLButtonElement>('[data-page-share]')!;
    const url = new URL(window.location.href);
    url.hash = 'play';
    input.value = url.href;
    const announce = (message: string) => {
      status.textContent = '';
      requestAnimationFrame(() => { status.textContent = message; });
    };
    const copy = async () => {
      try {
        await navigator.clipboard.writeText(input.value);
        announce(sharing.dataset.copied ?? '');
      } catch {
        input.focus();
        input.select();
        announce(sharing.dataset.failed ?? '');
      }
    };
    sharing.querySelector('[data-page-copy]')!.addEventListener('click', copy, { signal: events.signal });
    share.hidden = typeof navigator.share !== 'function';
    share.addEventListener('click', async () => {
      try {
        await navigator.share({ title: document.title, url: input.value });
        announce(sharing.dataset.shared ?? '');
      } catch (error) {
        if (error instanceof DOMException && error.name === 'AbortError') return;
        await copy();
      }
    }, { signal: events.signal });
  }
</script>
<style>
  .download-details { display: grid; gap: 0.85rem; width: 100%; font-size: 0.875rem; line-height: 1.6; }
  .download-details p { margin: 0; }
  .download-details a { text-decoration: underline; text-underline-offset: 0.2em; }
  .download-details details { border-top: 1px dashed currentColor; padding-top: 0.8rem; }
  .download-details summary { cursor: pointer; font-weight: 600; }
  .download-details section { margin-block: 1rem; }
  .download-details h3 { font-size: 1rem; margin-block: 0.8rem 0.3rem; }
  .download-details ol { padding-inline-start: 1.3rem; }
  .download-details li { margin-block: 0.4rem; }
  .download-details code { overflow-wrap: anywhere; font-size: 0.75rem; }
  .download-details__sharing { display: grid; gap: 0.5rem; }
  .download-details__actions { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .download-details button { min-height: 44px; padding: 0.5rem 0.85rem; border: 1px solid currentColor; background: transparent; color: inherit; font: inherit; cursor: pointer; }
  .download-details label { display: grid; gap: 0.3rem; }
  .download-details input { min-width: 0; width: 100%; padding: 0.6rem; border: 1px solid currentColor; background: transparent; color: inherit; font: inherit; }
  .download-details :is(button, input, summary, a):focus-visible { outline: 2px solid var(--red); outline-offset: 4px; }
</style>
