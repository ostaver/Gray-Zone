---
import type { Locale } from '../../i18n/config';
import { privacyCopy } from '../../data/privacy';

interface Props {
  locale: Locale;
  enabled?: boolean;
}

const { locale, enabled = true } = Astro.props;
const t = privacyCopy[locale];
---

<section
  class="privacy"
  data-privacy-consent
  data-analytics-enabled={String(enabled)}
  data-accepted={t.accepted}
  data-declined={t.declined}
  data-unavailable={t.unavailable}
  data-inactive={t.inactive}
  aria-label={t.title}
>
  <details id="privacy-preferences" class="privacy__panel" data-privacy-panel open>
    <summary class="privacy__title" data-privacy-summary>{t.title}</summary>
    <div class="privacy__body">
      <p>{t.intro}</p>
      {!enabled && <p class="privacy__inactive">{t.inactive}</p>}
      <details class="privacy__disclosure">
        <summary>{t.disclosure}</summary>
        <div class="privacy__information">
          <p>{t.analytics}</p>
          <p>{t.storage}</p>
          <p>{t.google} <a href="https://policies.google.com/privacy" rel="external">{t.googlePolicy}</a></p>
          <p>{t.downloads} <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement" rel="external">{t.githubPolicy}</a></p>
        </div>
      </details>
      <div class="privacy__actions" data-privacy-actions hidden>
        <button type="button" data-privacy-accept>{t.accept}</button>
        <button type="button" data-privacy-decline>{t.decline}</button>
      </div>
      <noscript><p class="privacy__inactive">{t.noScript}</p></noscript>
    </div>
  </details>
  <p class="privacy__status" data-privacy-status role="status" aria-live="polite" aria-atomic="true"></p>
  <a
    class="privacy__opener"
    href="#privacy-preferences"
    data-privacy-open
    aria-controls="privacy-preferences"
    aria-expanded="true"
    hidden
  >{t.preferences}</a>
</section>

<script>
  import { initPrivacyConsent } from '../../lib/privacy';

  const root = document.querySelector<HTMLElement>('[data-privacy-consent]');
  if (root) initPrivacyConsent(root);
</script>

<style>
  .privacy {
    position: relative;
    z-index: var(--z-content);
    color: var(--paper);
    background: var(--ink);
  }
  .privacy [hidden] {
    display: none;
  }
  .privacy__panel {
    padding: 1rem var(--gutter);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    background:
      radial-gradient(circle, var(--hairline) 1px, transparent 1px) right top / 8px 8px no-repeat,
      var(--ink-2);
    scroll-margin-block-start: calc(var(--nav-h) + 1rem);
  }
  .privacy__title {
    width: fit-content;
    font-family: var(--font-display);
    font-size: 1.25rem;
    cursor: pointer;
  }
  .privacy__body {
    display: grid;
    gap: 0.75rem;
    max-width: 66rem;
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    line-height: 1.55;
  }
  .privacy__disclosure > summary {
    width: fit-content;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .privacy__information {
    display: grid;
    gap: 0.75rem;
    max-width: 75ch;
    margin-top: 0.75rem;
  }
  .privacy__information a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .privacy__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
  }
  .privacy__actions button {
    min-height: 44px;
    padding: 0.625rem 1rem;
    border: 1px solid var(--paper-dim);
    background: var(--ink);
    color: var(--paper);
    font-weight: 600;
  }
  .privacy__actions button:hover {
    background: var(--concrete);
  }
  .privacy__inactive,
  .privacy__status {
    font-size: 0.875rem;
    color: var(--paper-dim);
  }
  .privacy__status:not(:empty) {
    padding: 0.75rem var(--gutter);
  }
  .privacy[data-enhanced] .privacy__panel:not([open]) {
    display: none;
  }
  .privacy[data-enhanced] .privacy__panel:not([open]) ~ .privacy__status {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .privacy__opener {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin: 1rem var(--gutter);
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--hairline);
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.3;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
