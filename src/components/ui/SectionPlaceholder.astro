---
/**
 * Stand-in for a section whose phase hasn't landed yet: holds the anchor id and some height so
 * the nav's seam index has something to track. Replace it with the real section in its phase.
 */
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section class="placeholder" id={id} aria-labelledby={`${id}-title`}>
  <h2 class="placeholder__title" id={`${id}-title`}>{title}</h2>
</section>

<style>
  .placeholder {
    position: relative;
    display: grid;
    align-content: end;
    gap: 1rem;
    min-height: 110svh;
    padding: calc(var(--nav-h) + 3rem) var(--gutter) var(--gutter);
    border-top: 1px solid var(--hairline);
    background: var(--ink);
  }
  .placeholder__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3.5rem, 13vw, 12rem);
    line-height: 0.85;
    text-transform: uppercase;
    color: transparent;
    -webkit-text-stroke: max(1px, 0.012em) var(--paper-dim);
  }
</style>
