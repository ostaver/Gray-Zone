---
import type { Locale } from '../../i18n/config';
import { ui } from '../../i18n/ui';
import { releases, releaseVersion } from '../../data/links';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale].download;
const a11y = ui[locale].a11y;
---

<dialog class="dl" data-download-dialog aria-labelledby="dl-title">
  <div class="dl__panel">
    <header class="dl__head">
      <p class="label dl__version">{t.version} {releaseVersion} · {t.size}</p>
      <button class="dl__close" type="button" data-download-close aria-label={a11y.close}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
      </button>
    </header>
    <h2 id="dl-title" class="dl__title">{t.title}</h2>
    <p class="dl__mobile" data-download-mobile hidden>{t.desktopOnly}</p>
    <div class="dl__options">
      <a class="dl__opt" href={releases.windows} data-platform="windows" download>
        <span class="dl__ring" aria-hidden="true"><span class="dl__spin"></span></span>
        <span class="dl__body">
          <span class="dl__os" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M3 5.5l7.5-1v7H3zM11.5 4.3L21 3v8.5h-9.5zM3 12.5h7.5v7L3 18.5zM11.5 12.5H21V21l-9.5-1.3z"></path></svg>
          </span>
          <span class="dl__name">{t.windows}</span>
          <span class="dl__badge label" data-detected-badge hidden>{t.detected}</span>
          <span class="dl__arrow" aria-hidden="true">↓</span>
        </span>
      </a>
      <a class="dl__opt" href={releases.mac} data-platform="mac" download>
        <span class="dl__ring" aria-hidden="true"><span class="dl__spin"></span></span>
        <span class="dl__body">
          <span class="dl__os" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M16.4 12.6c0-2.4 2-3.6 2.1-3.7-1.1-1.7-2.9-1.9-3.5-1.9-1.5-.2-2.9.9-3.7.9-.8 0-1.9-.9-3.2-.8-1.6 0-3.1 1-4 2.4-1.7 3-.4 7.3 1.2 9.7.8 1.2 1.8 2.5 3 2.4 1.2 0 1.7-.8 3.1-.8 1.5 0 1.9.8 3.2.8 1.3 0 2.2-1.2 3-2.4.9-1.4 1.3-2.7 1.3-2.8 0 0-2.5-1-2.5-3.8zM14 5.5c.7-.8 1.1-1.9 1-3-1 0-2.1.7-2.8 1.5-.6.7-1.2 1.8-1 2.9 1 .1 2.1-.6 2.8-1.4z"></path></svg>
          </span>
          <span class="dl__name">{t.mac}</span>
          <span class="dl__badge label" data-detected-badge hidden>{t.detected}</span>
          <span class="dl__arrow" aria-hidden="true">↓</span>
        </span>
      </a>
    </div>
    <p class="dl__note">{t.macNote}</p>
  </div>
</dialog>

<script>
  import { gsap, reducedMotion } from '../../lib/motion/gsap';
  import { lockScroll } from '../../lib/motion/scroll';
  import { detectPlatform } from '../../lib/platform';

  const dialog = document.querySelector<HTMLDialogElement>('[data-download-dialog]');
  if (dialog) {
    const panel = dialog.querySelector<HTMLElement>('.dl__panel')!;
    const platform = detectPlatform();
    const options = dialog.querySelector<HTMLElement>('.dl__options')!;
    if (platform) {
      const preferred = options.querySelector<HTMLElement>(`[data-platform="${platform}"]`)!;
      preferred.dataset.detected = '';
      preferred.querySelector<HTMLElement>('[data-detected-badge]')!.hidden = false;
      options.prepend(preferred);
    } else if (window.matchMedia('(pointer: coarse)').matches) {
      dialog.querySelector<HTMLElement>('[data-download-mobile]')!.hidden = false;
    }

    const open = () => {
      if (dialog.open) return;
      dialog.showModal();
      lockScroll(true);
      if (!reducedMotion.matches) {
        gsap.fromTo(dialog, { opacity: 0 }, { opacity: 1, duration: 0.4, ease: 'power2.out' });
        gsap.fromTo(panel, { yPercent: 12, clipPath: 'inset(100% 0 0 0)' }, { yPercent: 0, clipPath: 'inset(0% 0 0 0)', duration: 0.9 });
        gsap.fromTo(panel.querySelectorAll('.dl__opt, .dl__title, .dl__note'), { y: 30, opacity: 0 }, { y: 0, opacity: 1, duration: 0.9, stagger: 0.06, delay: 0.15 });
      }
    };
    const close = () => {
      if (!dialog.open) return;
      if (reducedMotion.matches) {
        dialog.close();
        return;
      }
      gsap.to(dialog, { opacity: 0, duration: 0.3, ease: 'power2.in', onComplete: () => dialog.close() });
    };

    document.addEventListener('click', (e) => {
      // Modified clicks keep their native meaning (new tab/window, save link).
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      const trigger = (e.target as Element).closest('[data-download]');
      if (!trigger) return;
      e.preventDefault();
      open();
    });
    dialog.querySelector('[data-download-close]')!.addEventListener('click', close);
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) close();
    });
    dialog.addEventListener('cancel', (e) => {
      e.preventDefault();
      close();
    });
    dialog.addEventListener('close', () => lockScroll(false));
  }
</script>

<style>
  .dl {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    padding: var(--gutter);
    border: 0;
    background: rgb(10 10 10 / 0.72);
    backdrop-filter: blur(10px) saturate(0.2);
    color: var(--paper);
    display: grid;
    place-items: center;
  }
  .dl:not([open]) {
    display: none;
  }
  .dl::backdrop {
    background: transparent;
  }
  .dl__panel {
    width: min(100%, 38rem);
    /* A faint red bloom from the top edge echoes the CTA's ring without adding motion. */
    background:
      radial-gradient(120% 70% at 50% -10%, color-mix(in srgb, var(--red) 9%, transparent), transparent 60%),
      var(--ink-2);
    border: 1px solid var(--hairline);
    border-radius: 20px;
    box-shadow: inset 0 1px 0 rgb(239 236 230 / 0.06);
    padding: clamp(1.25rem, 3vw, 2.25rem);
    display: grid;
    gap: 1.25rem;
  }
  .dl__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--ash);
  }
  .dl__version::before {
    content: '■';
    margin-right: 0.45rem;
    color: var(--red);
    font-size: 0.5rem;
    vertical-align: 0.1em;
  }
  .dl__close {
    width: 2.5rem;
    height: 2.5rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--hairline);
    border-radius: 50%;
    transition: border-color 0.3s, transform 0.5s var(--ease-out);
  }
  .dl__close:hover {
    border-color: var(--paper);
    transform: rotate(90deg);
  }
  .dl__close svg {
    width: 1rem;
    stroke: currentColor;
    stroke-width: 1.5;
    fill: none;
  }
  .dl__title {
    font-family: var(--font-display);
    font-weight: 600;
    text-transform: uppercase;
    font-size: clamp(2.25rem, 6vw, 3.75rem);
    line-height: 0.9;
    letter-spacing: -0.01em;
  }
  .dl__mobile {
    color: var(--blush);
  }
  .dl__options {
    display: grid;
    gap: 0.625rem;
  }
  .dl__opt {
    --ring: 2px;
    --radius: 14px;
    position: relative;
    display: block;
    padding: var(--ring);
    border-radius: var(--radius);
    background: var(--hairline);
    isolation: isolate;
  }
  .dl__opt:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 3px;
  }
  .dl__opt[data-detected] {
    box-shadow: 0 0 28px -6px color-mix(in srgb, var(--red) 45%, transparent);
  }
  /* The hero CTA's orbiting ring: lit on the detected platform, faded in on hover elsewhere.
     Paused while unlit so idle options cost nothing. */
  .dl__ring {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    opacity: 0;
    transition: opacity 0.5s var(--ease-out);
  }
  .dl__spin {
    /* A square wider than the option's diagonal, so the rotation never exposes a corner. */
    position: absolute;
    top: 50%;
    left: 50%;
    width: 150%;
    aspect-ratio: 1;
    translate: -50% -50%;
    background: conic-gradient(
      from 0deg,
      var(--red),
      var(--ember),
      var(--red),
      var(--red-deep),
      var(--oxblood),
      var(--red-deep),
      var(--red)
    );
    animation: dl-spin 4s linear infinite paused;
    will-change: transform;
  }
  .dl__opt[data-detected] .dl__ring,
  .dl__opt:hover .dl__ring,
  .dl__opt:focus-visible .dl__ring {
    opacity: 1;
  }
  .dl__opt[data-detected] .dl__spin,
  .dl__opt:hover .dl__spin,
  .dl__opt:focus-visible .dl__spin {
    animation-play-state: running;
  }
  .dl__body {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: 'os name arrow' 'os badge arrow';
    align-items: center;
    column-gap: 1rem;
    padding: 0.9rem 1.1rem 0.9rem 0.9rem;
    border-radius: calc(var(--radius) - var(--ring));
    background: var(--ink);
    box-shadow: inset 0 1px 0 rgb(239 236 230 / 0.06);
    isolation: isolate;
    overflow: hidden;
    transition: transform 0.15s ease-out;
  }
  /* Hover warmth is a static gradient faded by opacity rather than a repainted fill. */
  .dl__body::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(70% 160% at 0% 50%, color-mix(in srgb, var(--red) 20%, transparent), transparent 70%);
    opacity: 0;
    transition: opacity 0.5s var(--ease-out);
  }
  .dl__opt:hover .dl__body::before,
  .dl__opt:focus-visible .dl__body::before {
    opacity: 1;
  }
  .dl__opt:active .dl__body {
    transform: scale(0.99);
  }
  .dl__os {
    grid-area: os;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--hairline);
    border-radius: 10px;
    background: var(--ink-2);
  }
  .dl__os svg {
    width: 1.35rem;
    fill: currentColor;
  }
  .dl__name {
    grid-area: name;
    font-family: var(--font-display);
    font-size: 1.35rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1.05;
  }
  .dl__badge {
    grid-area: badge;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.25rem;
    color: var(--blush);
    font-size: 0.6875rem;
  }
  /* An author display value would otherwise override the UA's [hidden] rule. */
  .dl__badge[hidden] {
    display: none;
  }
  .dl__badge::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--red);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--red) 25%, transparent);
  }
  .dl__arrow {
    grid-area: arrow;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--hairline);
    border-radius: 50%;
    font-size: 1.1rem;
    transition: transform 0.5s var(--ease-out);
  }
  .dl__opt:hover .dl__arrow {
    transform: translateY(3px);
  }
  .dl__note {
    padding-top: 1rem;
    border-top: 1px solid var(--hairline);
    color: var(--ash);
    font-size: 0.8125rem;
    line-height: 1.5;
    text-wrap: pretty;
  }
  @keyframes dl-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .dl__spin {
      animation: none;
    }
  }
</style>
