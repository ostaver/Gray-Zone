---
import '@fontsource-variable/oswald';
import '@fontsource-variable/inter-tight';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';

import { htmlLang, locales, localePath, ogLocale, type Locale } from '../i18n/config';
import { ui } from '../i18n/ui';
import { OG_IMAGE_HEIGHT, OG_IMAGE_WIDTH, ogImagePath, ogImageVariants, type OgExt } from '../lib/og';
import { latestRelease, releaseVersion, repo } from '../data/links';
import FpsStats from '../components/debug/FpsStats.astro';
import ScrollRail from '../components/shell/ScrollRail.astro';

interface Props {
  locale: Locale;
  /** Locale-free path of this page, e.g. '/'. */
  path?: string;
  /** Kept out of search (the 404): no robots indexing, canonical or language alternates. */
  noindex?: boolean;
}

const { locale, path = '/', noindex = false } = Astro.props;
const t = ui[locale];
const canonical = new URL(localePath(locale, path), Astro.site);
const ogImageUrl = (ext: OgExt) => new URL(ogImagePath(ext), Astro.site).href;

// Describes the game to search engines (schema.org VideoGame): free, desktop, in both languages.
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: t.meta.siteName,
  alternateName: locales.filter((l) => l !== locale).map((l) => ui[l].meta.siteName),
  description: t.meta.description,
  url: canonical.href,
  image: ogImageUrl('jpg'),
  inLanguage: locales.map((l) => htmlLang[l]),
  genre: ['Educational', 'Simulation'],
  gamePlatform: ['PC', 'Mac'],
  operatingSystem: 'Windows, macOS',
  applicationCategory: 'GameApplication',
  softwareVersion: releaseVersion,
  downloadUrl: latestRelease,
  codeRepository: repo,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR', availability: 'https://schema.org/InStock' },
};
---

<!doctype html>
<html lang={htmlLang[locale]} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="theme-color" content="#0a0a0a" />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="canonical" href={canonical} />
          {locales.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={new URL(localePath(l, path), Astro.site)} />)}
          <link rel="alternate" hreflang="x-default" href={new URL(localePath('mk', path), Astro.site)} />
          <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
        </>
      )
    }
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.meta.siteName} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[locale]} />
    {locales.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
    {ogImageVariants.map(({ ext, type }) => (
      <>
        <meta property="og:image" content={ogImageUrl(ext)} />
        <meta property="og:image:type" content={type} />
        <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
        <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
        <meta property="og:image:alt" content={t.meta.imageAlt} />
      </>
    ))}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl('jpg')} />
    <meta name="twitter:image:alt" content={t.meta.imageAlt} />

    <script is:inline>
      // Before first paint: restore session preferences; preload runs in full on the first visit, short after.
      (function () {
        var d = document.documentElement;
        d.classList.replace('no-js', 'js');
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var seen = false;
        try {
          seen = sessionStorage.getItem('sz-seen') === '1';
          sessionStorage.setItem('sz-seen', '1');
          if (sessionStorage.getItem('sz-zone') === 'white') d.dataset.zone = 'white';
        } catch (e) {}
        d.dataset.preload = reduce ? 'none' : seen ? 'short' : 'full';
        document.querySelector('meta[name="theme-color"]').setAttribute('content', getComputedStyle(d).getPropertyValue('--ink').trim());
      })();
    </script>

  </head>
  <body>
    <Fragment set:html="<!-- OSTAVER: The intersection of Art and Abstract Expression -->" />
    <canvas id="gl-stage" aria-hidden="true"></canvas>
    <slot name="chrome" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
    <ScrollRail locale={locale} />
    <div class="grain" aria-hidden="true"></div>
    {import.meta.env.DEV && <FpsStats />}
  </body>
</html>

<script>
  import { initScroll } from '../lib/motion/scroll';
  initScroll();
</script>

<style>
  #gl-stage {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100lvh;
    z-index: var(--z-gl);
    pointer-events: none;
  }
  main {
    position: relative;
    z-index: var(--z-content);
  }
</style>
