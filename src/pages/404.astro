---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { localePath } from '../i18n/config';
import { ui } from '../i18n/ui';
import { notFoundCopy } from '../data/notFound';
import logo from '../assets/brand/logo.png';
import CoolButton from '../components/ui/CoolButton.astro';

const mk = notFoundCopy.mk;
const en = notFoundCopy.en;
---

<Base locale="mk" path="/404" title={`404 — ${mk.stamp} / ${en.stamp}`} noindex>
  <section class="nf" aria-labelledby="nf-title" data-not-found>
    <a class="nf__brand" href={localePath('mk')} aria-label={ui.mk.meta.siteName}>
      <Image src={logo} alt="" width={96} height={96} />
    </a>
    <p class="nf__code" aria-hidden="true">404</p>

    <!-- A slip from the archive's counter, in both languages: a missing page can't know which. -->
    <article class="nf__slip" data-nf-slip>
      <header class="nf__head">
        <span class="label">{mk.doc}</span>
        <span class="label" lang="en">{en.doc}</span>
      </header>
      <h1 class="nf__title" id="nf-title">{mk.title}</h1>
      <p class="nf__text">{mk.text}</p>
      <div class="nf__en" lang="en">
        <p class="nf__title nf__title--en">{en.title}</p>
        <p class="nf__text">{en.text}</p>
      </div>
      <span class="nf__stamp" aria-hidden="true" data-nf-stamp>
        <span class="flap-board" data-flap>{mk.stamp}</span>
        <span class="flap-board" lang="en" data-flap>{en.stamp}</span>
      </span>
      <nav class="nf__links" aria-label={`${mk.home} · ${en.home}`}>
        <CoolButton href={localePath('mk')}>
          <span>{mk.home}</span>
          <span aria-hidden="true">→</span>
        </CoolButton>
        <CoolButton href={localePath('en')} lang="en" hreflang="en">
          <span>{en.home}</span>
          <span aria-hidden="true">→</span>
        </CoolButton>
      </nav>
    </article>
  </section>
</Base>

<script>
  import { gsap, reducedMotion } from '../lib/motion/gsap';
  import { flapBoard } from '../lib/motion/flap';

  // The slip is dropped onto the counter, then the board hung on its corner clatters out the verdict.
  const slip = document.querySelector<HTMLElement>('[data-nf-slip]');
  const boards = [...document.querySelectorAll<HTMLElement>('[data-nf-stamp] [data-flap]')].map(flapBoard);
  if (slip && boards.length && !reducedMotion.matches) {
    for (const board of boards) board.blank();
    gsap
      .timeline({ delay: 0.2 })
      .from(slip, { yPercent: -40, rotation: 6, opacity: 0, duration: 1.1, ease: 'tear' })
      .add(() => boards.forEach((board) => board.flip()), 0.9);
  }
</script>

<style>
  .nf {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding: 6rem var(--gutter) 4rem;
    overflow: hidden;
  }
  .nf__brand {
    position: absolute;
    top: 1.25rem;
    left: var(--gutter);
    width: 3.5rem;
  }
  .nf__brand img {
    width: 100%;
    height: auto;
  }
  /* The number, hollow and huge, behind the slip. */
  .nf__code {
    position: absolute;
    inset: 50% auto auto 50%;
    translate: -50% -50%;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(12rem, 42vw, 40rem);
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: max(1px, 0.004em) var(--paper-dim);
    user-select: none;
  }
  /* Paper as the story's forms: fixed colours whatever the zone. */
  .nf__slip {
    position: relative;
    display: grid;
    gap: 1rem;
    width: min(100%, 34rem);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background: var(--zone-white);
    color: var(--zone-black);
    transform: rotate(-1.5deg);
    margin-top: 2rem;
    box-shadow: 0 34px 60px -28px rgb(0 0 0 / 0.75);
  }
  .nf__head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid currentColor;
    opacity: 0.7;
  }
  .nf__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 0.95;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .nf__title--en {
    font-size: clamp(1.25rem, 2.6vw, 1.6rem);
  }
  .nf__text {
    line-height: 1.45;
    text-wrap: pretty;
  }
  .nf__en {
    display: grid;
    gap: 0.5rem;
    padding-top: 1rem;
    border-top: 1px dashed currentColor;
    opacity: 0.75;
  }
  /* A two-line split-flap board (styles/flap.css) hung across the slip's corner, clear of the
     text. */
  .nf__stamp {
    position: absolute;
    right: clamp(-1.5rem, -2vw, -0.25rem);
    top: -1.75em;
    display: grid;
    justify-items: end;
    gap: 0.14em;
    font-size: clamp(1.1rem, 3.2vw, 1.75rem);
    transform: rotate(-3deg);
    filter: drop-shadow(0 0.35em 0.3em rgb(0 0 0 / 0.35));
    pointer-events: none;
  }
  .nf__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
</style>
